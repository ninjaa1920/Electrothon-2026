<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Police Details</title>
    <link rel="stylesheet" href="/police_details.css">
  </head>

  <body>
    <main class="wrap">
      <header class="hd">
        <h1>Police Details</h1>
        <p class="lead">Provide officer information (visible when Police is selected)</p>
      </header>

      <form class="form" action="/police/verify" method="POST">

        <label for="officerName">Officer Name</label>
        <input id="officerName" name="officerName" placeholder="Officer Jane Doe" required />

        <label for="batchNo">Batch Number</label>
        <input id="batchNo" name="batchNo" placeholder="e.g. BATCH-12345" required />

        <div class="row actions">
          <button type="submit" class="btn primary">Proceed</button>
          <a class="btn" href="/">Back</a>
        </div>
      </form>

      <% if (typeof error !== "undefined") { %>
        <div class="message error"><%= error %></div>
      <% } %>
    </main>
  </body>
</html>

