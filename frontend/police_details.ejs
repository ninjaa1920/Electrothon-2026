<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Police Details</title>
  <link rel="stylesheet" href="/police_details.css">
</head>

<body>
  <main class="wrap">
    <header class="hd">
      <h1>Police Details</h1>
      <p class="lead">Provide officer information (visible when Police is selected)</p>
    </header>

    <form class="form" action="/police/login" method="POST">

      <label>Officer Name</label>
      <input type="text" name="officer_name" required>

      <label>Batch Number</label>
      <input type="text" name="batch_number" required>

      <button type="submit" class="btn primary">Login</button>

      <% if (typeof error !=="undefined" ) { %>
        <div class="message error">
          <%= error %>
        </div>
        <% } %>

    </form>
  </main>
</body>

</html>